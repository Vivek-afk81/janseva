  <diagram id="decision-table" name="Decision Table">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="decision-base"/>
        <mxCell id="decision-layer" parent="decision-base"/>
        <mxCell id="decision-title" value="Civic Issue Reporting System: Issue Reporting Decision Table" style="text;html=1;align=center;verticalAlign=middle;fontStyle=1;fontSize=20;fontColor=#1f2937;" vertex="1" parent="decision-layer">
          <mxGeometry x="80" y="30" width="1440" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="decision-table-shape" value="&lt;table border=&quot;1&quot; cellpadding=&quot;8&quot; cellspacing=&quot;0&quot; width=&quot;100%&quot; style=&quot;border-collapse:collapse;font-size:12px;text-align:left;&quot;&gt;&lt;tr style=&quot;background-color:#1f4e78;color:#ffffff;font-weight:bold;&quot;&gt;&lt;td&gt;Rule&lt;/td&gt;&lt;td&gt;Authenticated?&lt;/td&gt;&lt;td&gt;Role&lt;/td&gt;&lt;td&gt;Fields valid?&lt;/td&gt;&lt;td&gt;Online?&lt;/td&gt;&lt;td&gt;Gemini?&lt;/td&gt;&lt;td&gt;System decision&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;R1&lt;/td&gt;&lt;td&gt;No&lt;/td&gt;&lt;td&gt;Any&lt;/td&gt;&lt;td&gt;Any&lt;/td&gt;&lt;td&gt;Any&lt;/td&gt;&lt;td&gt;Any&lt;/td&gt;&lt;td&gt;Reject submission and redirect to login.&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#fce4d6;&quot;&gt;&lt;td&gt;R2&lt;/td&gt;&lt;td&gt;Yes&lt;/td&gt;&lt;td&gt;Engineer/Supervisor&lt;/td&gt;&lt;td&gt;Any&lt;/td&gt;&lt;td&gt;Any&lt;/td&gt;&lt;td&gt;Any&lt;/td&gt;&lt;td&gt;Reject citizen report creation; role is not permitted.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;R3&lt;/td&gt;&lt;td&gt;Yes&lt;/td&gt;&lt;td&gt;Citizen&lt;/td&gt;&lt;td&gt;No&lt;/td&gt;&lt;td&gt;Any&lt;/td&gt;&lt;td&gt;Any&lt;/td&gt;&lt;td&gt;Reject and display validation errors.&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#e2f0d9;&quot;&gt;&lt;td&gt;R4&lt;/td&gt;&lt;td&gt;Yes&lt;/td&gt;&lt;td&gt;Citizen&lt;/td&gt;&lt;td&gt;Yes&lt;/td&gt;&lt;td&gt;Yes&lt;/td&gt;&lt;td&gt;Yes&lt;/td&gt;&lt;td&gt;Upload image, predict priority, save to Firestore, status Open.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;R5&lt;/td&gt;&lt;td&gt;Yes&lt;/td&gt;&lt;td&gt;Citizen&lt;/td&gt;&lt;td&gt;Yes&lt;/td&gt;&lt;td&gt;Yes&lt;/td&gt;&lt;td&gt;No&lt;/td&gt;&lt;td&gt;Save with default Medium priority and mark AI unavailable.&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#fff2cc;&quot;&gt;&lt;td&gt;R6&lt;/td&gt;&lt;td&gt;Yes&lt;/td&gt;&lt;td&gt;Citizen&lt;/td&gt;&lt;td&gt;Yes&lt;/td&gt;&lt;td&gt;No&lt;/td&gt;&lt;td&gt;Any&lt;/td&gt;&lt;td&gt;Store in IndexedDB as Pending Sync; retry on reconnect.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;R7&lt;/td&gt;&lt;td&gt;Yes&lt;/td&gt;&lt;td&gt;Citizen&lt;/td&gt;&lt;td&gt;Yes&lt;/td&gt;&lt;td&gt;Yes&lt;/td&gt;&lt;td&gt;Any&lt;/td&gt;&lt;td&gt;If image upload fails, retain locally and retry.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;R8&lt;/td&gt;&lt;td&gt;Yes&lt;/td&gt;&lt;td&gt;Citizen&lt;/td&gt;&lt;td&gt;Yes&lt;/td&gt;&lt;td&gt;Yes&lt;/td&gt;&lt;td&gt;Any&lt;/td&gt;&lt;td&gt;If Firestore write fails, retain in the local sync queue.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;R9&lt;/td&gt;&lt;td&gt;Yes&lt;/td&gt;&lt;td&gt;Engineer&lt;/td&gt;&lt;td&gt;N/A&lt;/td&gt;&lt;td&gt;Yes&lt;/td&gt;&lt;td&gt;N/A&lt;/td&gt;&lt;td&gt;View assigned issues, update status, and add notes.&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background-color:#d9eaf7;&quot;&gt;&lt;td&gt;R10&lt;/td&gt;&lt;td&gt;Yes&lt;/td&gt;&lt;td&gt;Supervisor&lt;/td&gt;&lt;td&gt;N/A&lt;/td&gt;&lt;td&gt;Yes&lt;/td&gt;&lt;td&gt;N/A&lt;/td&gt;&lt;td&gt;View all issues, assign engineers, update status, override priority.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;br&gt;&lt;b&gt;Post-condition:&lt;/b&gt; After successful synchronization, remove the IndexedDB entry and update the Firestore status to Open." style="shape=rectangle;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;fillColor=#ffffff;strokeColor=#7f8c8d;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="decision-layer">
          <mxGeometry x="60" y="100" width="1480" height="760" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
